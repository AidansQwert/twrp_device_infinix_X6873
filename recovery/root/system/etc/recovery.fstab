# TWRP recovery fstab for Infinix GT 30 Pro (X6873) — MediaTek MT6897
#
# Derived from the stock fstab extracted from vendor_boot.img
# (vendor/mediatek/proprietary/hardware/fstab/mt6897/fstab.in.emmc).
#
# IMPORTANT — brick safety:
#   Every "flags=" entry below deliberately omits bootloader, preloader, lk,
#   seccfg, efuse, proinfo and para. Exposing those in the TWRP GUI is how
#   MediaTek devices get hard-bricked: a mis-tap on "Install image" targeting
#   the preloader leaves the SoC unable to reach fastboot. They are not listed,
#   so TWRP cannot offer them.
#
# Format: <mount point> <fstype> <device> [<device2>] <flags>

# ---------------------------------------------------------------- data
# The flag string below is TWRP's own flag vocabulary (bootable/recovery/
# partition.cpp tw_flags[]), parsed case-sensitively after "flags=".
#
# Two flags that were here are deliberately gone:
#   length=2147483648  TWRP stores it in TWPartition::Length and, when it is
#                      non-zero, computes the partition size as
#                      Block_Count = Length / 1024 (partition.cpp:2056-2067).
#                      That pinned /data at 2 GiB, so the reported size, free
#                      space and backup accounting were all wrong. No length=
#                      belongs on a real block partition.
#   wrappedkey         That claims hardware-wrapped FBE keys. The stock fstab
#                      in first_stage_ramdisk/fstab.mt6897 does not ask for
#                      wrapped keys (no wrappedkey/wrappedkey_v0 anywhere), so
#                      declaring it only misleads the crypto path.
#
# fileencryption now matches stock exactly, including the trailing
# +inlinecrypt_optimized modifier.
/data           f2fs    /dev/block/by-name/userdata                    flags=display="Data";fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized;keydirectory=/metadata/vold/metadata_encryption;quota;wipeingui;backup=1
/metadata       f2fs    /dev/block/by-name/metadata                    flags=display="Metadata";backup=0;wipeingui

# --------------------------------------------------- logical (in super)
# Read-only system partitions live in the dynamic "super" partition.
# slotselect is required: this is an A/B device.
/system_root    erofs   system                                         flags=display="System";logical;slotselect;backup=0
/vendor         erofs   vendor                                         flags=display="Vendor";logical;slotselect;backup=0
/system_ext     erofs   system_ext                                     flags=display="System_ext";logical;slotselect;backup=0
/product        erofs   product                                        flags=display="Product";logical;slotselect;backup=0
/odm            erofs   odm                                            flags=display="Odm";logical;slotselect;backup=0

# ------------------------------------------------------ boot chain (A/B)
/boot           emmc    /dev/block/by-name/boot                        flags=display="Boot";slotselect;backup=1;flashimg=1
/init_boot      emmc    /dev/block/by-name/init_boot                   flags=display="Init_boot";slotselect;backup=1;flashimg=1
/vendor_boot    emmc    /dev/block/by-name/vendor_boot                 flags=display="Vendor_boot";backup=1;flashimg=1
/dtbo           emmc    /dev/block/by-name/dtbo                        flags=display="Dtbo";slotselect;backup=1;flashimg=1
/vbmeta         emmc    /dev/block/by-name/vbmeta                      flags=display="Vbmeta";backup=1;flashimg=1
/vbmeta_system  emmc    /dev/block/by-name/vbmeta_system               flags=display="Vbmeta_system";slotselect;backup=1;flashimg=1
/vbmeta_vendor  emmc    /dev/block/by-name/vbmeta_vendor               flags=display="Vbmeta_vendor";slotselect;backup=1;flashimg=1

# ------------------------------------------------- vendor data partitions
/mnt/vendor/persist   ext4  /dev/block/by-name/persist                 flags=display="Persist";backup=0
/mnt/vendor/nvdata    ext4  /dev/block/by-name/nvdata                  flags=display="Nvdata";backup=1
/mnt/vendor/nvcfg     ext4  /dev/block/by-name/nvcfg                   flags=display="Nvcfg";backup=1
/mnt/vendor/protect_f ext4  /dev/block/by-name/protect1                flags=display="Protect_f";backup=1
/mnt/vendor/protect_s ext4  /dev/block/by-name/protect_s2              flags=display="Protect_s";backup=0

# ------------------------------------------------------ modem / firmware
# Backup-only. No flashimg: these are signed images and a wrong write bricks
# radio or the TEE.
/nvram          emmc    /dev/block/by-name/nvram                       flags=display="Nvram";backup=1
/modem          emmc    /dev/block/by-name/modem                       flags=display="Modem";backup=1
/md1img         emmc    /dev/block/by-name/md1img                      flags=display="Md1img";backup=1
/logo           emmc    /dev/block/by-name/logo                        flags=display="Logo";backup=1

# ------------------------------------------------------ external storage
/external_sd    auto    /dev/block/mmcblk0p1  /dev/block/mmcblk0       flags=display="MicroSD";storage;wipeingui;removable
/usb_otg        auto    /dev/block/sda1       /dev/block/sda           flags=display="USB OTG";storage;wipeingui;removable
